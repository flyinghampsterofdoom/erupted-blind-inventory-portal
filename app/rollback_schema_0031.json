  "triggers": [
    [
      "schedule_generator_snapshots_immutable",
      "O",
      "CREATE TRIGGER schedule_generator_snapshots_immutable BEFORE DELETE OR UPDATE OR TRUNCATE ON schedule_generator_snapshots FOR EACH STATEMENT EXECUTE FUNCTION reject_schedule_generator_snapshot_mutation()",
      "CREATE OR REPLACE FUNCTION public.reject_schedule_generator_snapshot_mutation()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\n        BEGIN\n            RAISE EXCEPTION 'Generator snapshots are immutable audit evidence';\n        END;\n        $function$\n"
    ]
